# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# 数据与运行产物（大文件不进仓库）
runs/
*.mseed
*.hdf5
*.hdf5.partial
*.csv.partial
data/seisbench_cache/

# 但权重备份要保留（体积小、开机要用），显式放行
!weights/*.tar.gz

# 本地临时
*.log
.DS_Store
.playwright-mcp/

# 本地评审/探针/中间产物（含敏感评审报告，不进公开仓库）
outputs/

# 服务器侧运行时产物（deploy 脚本在仓库根生成）
serve_api_supervisor.sh
*.pid
probe_sample/
captured/

*.csv
/content/ethz_100hz_subset.hdf5

# SeismicXM 预训练权重（2GB，Google Drive 下载，见 memory/训练脚本注释）
weights/seismicxm/

# USTC-Pickers 区域权重: 只入库实测胜出的 guangxi/huanan 转换版, 其余本地保留
weights/ustc_pickers/*
!weights/ustc_pickers/guangxi_sd.pt
!weights/ustc_pickers/huanan_sd.pt
!weights/ustc_pickers/jiangxi_sd.pt
!weights/ustc_pickers/shandong_sd.pt

# fork 验证的集成第4/5成员(域内增强+CREW 微调), 三分布消融为正
!weights/aug/
!weights/aug/*.pt

# GEOFON 候选只保留最终入选的 m1/m3 state_dict；完整 checkpoint 与淘汰成员留本地
weights/geofon/*
!weights/geofon/geofon_m1_last_sd.pt
!weights/geofon/geofon_m3_last_sd.pt
